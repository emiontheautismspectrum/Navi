# Скопируйте этот файл в .env и заполните под выбранного провайдера.
# Переключение провайдера — одна строка, код менять не нужно.

# ── Выбор провайдера: anthropic | yandex | gemini | groq ────────────────────
LLM_PROVIDER=yandex

# ── Общее (необязательно) ────────────────────────────────────────────────
# Если не задано — используется дефолтная модель выбранного провайдера
# (см. _DEFAULT_MODELS в app/llm_client.py)
# MODEL_NAME=

# ── YandexGPT ─────────────────────────────────────────────────────────────
# Партнёр кейса — на хакатоне обычно выдают промокод/грант на API.
# Ключ: https://yandex.cloud/ru/docs/iam/operations/api-key/create
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── Anthropic (Claude) ────────────────────────────────────────────────────
# Платно, от ~$5 минимального пополнения. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Google Gemini ─────────────────────────────────────────────────────────
# Бесплатный тариф без карты (лимит ~10 запросов/мин).
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Groq ──────────────────────────────────────────────────────────────────
# Полностью бесплатно, до 14 400 запросов/день, без карты.
# Ключ: https://console.groq.com/keys
GROQ_API_KEY=
