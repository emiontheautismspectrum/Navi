# Copy to .env and fill in. The minimum to run is the YandexGPT block.

# ── Model provider: yandex | anthropic | gemini | groq ────────────────
# Switched with one line; the code does not change.
LLM_PROVIDER=yandex

# Model. If not set, the provider's default is used
# (see _DEFAULT_MODELS in app/llm_client.py).
# For demos, lite answers in a second or two instead of five.
MODEL_NAME=yandexgpt-lite/latest

# ── YandexGPT ───────────────────────────────────────────────────────────
# The service account needs the ai.languageModels.user role, otherwise you get 403.
# FOLDER_ID is visible in the folder console's address bar.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── Voice: ElevenLabs (optional) ───────────────────────────────────
# Without a key, the voice and microphone buttons report that the feature is unavailable.
# Voices can be browsed at /voices on a running backend.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=

# ── Automations: n8n (optional) ──────────────────────────────────
# Production URL of the webhook from the n8n/01-tickets-to-telegram.json workflow.
# Events are sent without waiting for a response: an unavailable n8n
# does not affect the system.
N8N_WEBHOOK_URL=

# ── Fallback providers ─────────────────────────────────────────────────
# Needed only if you switch LLM_PROVIDER to one of them.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
