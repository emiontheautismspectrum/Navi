# Скопируйте в .env и заполните. Минимум для работы — блок YandexGPT.

# ── Провайдер модели: yandex | anthropic | gemini | groq ────────────────
# Переключается одной строкой, код при этом не меняется.
LLM_PROVIDER=yandex

# Модель. Если не задать, возьмётся дефолтная для провайдера
# (см. _DEFAULT_MODELS в app/llm_client.py).
# Для демо lite отвечает за секунду-две вместо пяти.
MODEL_NAME=yandexgpt-lite/latest

# ── YandexGPT ───────────────────────────────────────────────────────────
# Сервисному аккаунту нужна роль ai.languageModels.user, иначе будет 403.
# FOLDER_ID виден в адресной строке консоли каталога.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ── Голос: ElevenLabs (необязательно) ───────────────────────────────────
# Без ключа кнопки озвучки и микрофона сообщают, что функция недоступна.
# Голоса можно посмотреть на /voices работающего бэкенда.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=

# ── Автоматизации: n8n (необязательно) ──────────────────────────────────
# Production URL вебхука из воркфлоу n8n/01-tickets-to-telegram.json.
# События отправляются без ожидания ответа: недоступный n8n
# не влияет на работу системы.
N8N_WEBHOOK_URL=

# ── Запасные провайдеры ─────────────────────────────────────────────────
# Нужны, только если переключить LLM_PROVIDER на один из них.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
