{
  "name": "Navi · Держать сервис разбуженным",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 10 }] }
      },
      "id": "d4000000-0000-4000-8000-000000000001",
      "name": "Каждые 10 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-300, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.NAVI_API_URL }}/health",
        "options": { "timeout": 90000 }
      },
      "id": "d4000000-0000-4000-8000-000000000002",
      "name": "Проверить бэкенд",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-60, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "alive",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000003",
      "name": "Сервис не ответил?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.NAVI_TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ Navi не отвечает на проверку. Время: {{ $now.format('dd.MM HH:mm') }}",
        "additionalFields": {}
      },
      "id": "d4000000-0000-4000-8000-000000000004",
      "name": "Сообщить о сбое",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [420, 220]
    }
  ],
  "connections": {
    "Каждые 10 минут": { "main": [[{ "node": "Проверить бэкенд", "type": "main", "index": 0 }]] },
    "Проверить бэкенд": { "main": [[{ "node": "Сервис не ответил?", "type": "main", "index": 0 }]] },
    "Сервис не ответил?": { "main": [[{ "node": "Сообщить о сбое", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
